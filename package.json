{
  "name": "synerry-shorturl",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n gateway,redirect,analytics,web -c red,blue,green,magenta \"npm run dev -w @synerry/gateway\" \"npm run dev -w @synerry/redirect\" \"npm run dev -w @synerry/analytics\" \"npm run dev -w @synerry/frontend\"",
    "build:web": "npm run build -w @synerry/frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w @synerry/gateway -w @synerry/analytics",
    "db:migrate": "npm run db:migrate -w @synerry/gateway -w @synerry/analytics",
    "db:seed": "npm run db:seed -w @synerry/gateway",
    "seed:clicks": "node scripts/seed-clicks.mjs",
    "test": "npm run test --workspaces --if-present",
    "warmup": "node scripts/warmup.mjs",
    "warmup:live": "node scripts/warmup.mjs https://synerry-gateway.onrender.com https://synerry-redirect.onrender.com https://synerry-analytics.onrender.com",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
