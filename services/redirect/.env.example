# พอร์ตที่ redirect service รัน (service นี้ไม่มีฐานข้อมูลของตัวเอง)
PORT=3002
# URL ภายในของ gateway ใช้ค้นลิงก์
GATEWAY_URL=http://localhost:3001
# URL ภายในของ analytics ใช้บันทึกคลิก
ANALYTICS_URL=http://localhost:3003
# URL หน้าเว็บหลัก ใช้พาผู้ใช้ไปเมื่อเปิดโดเมนเปล่า หรือกดปุ่มในหน้า error
APP_URL=http://localhost:5173
# key ลับที่ service ใช้เรียกกันเอง ต้องตรงกับของ gateway และ analytics
INTERNAL_API_KEY=dev-internal-key-change-me
# เวลารอค้นลิงก์สูงสุด (มิลลิวินาที)
LOOKUP_TIMEOUT_MS=3000
# เวลารอบันทึกคลิกสูงสุด (มิลลิวินาที) เกินแล้วพาไปปลายทางเลย
CLICK_TIMEOUT_MS=1500
