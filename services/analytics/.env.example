# พอร์ตที่ analytics service รัน
PORT=3003
# connection string ของ analytics_db (local ใช้ docker-compose, production ใช้ Neon)
DATABASE_URL=postgres://analytics_user:analytics_pass@localhost:5434/analytics_db
# key ลับที่ service ใช้เรียกกันเอง ต้องตรงกับของ gateway และ redirect
INTERNAL_API_KEY=dev-internal-key-change-me
# salt ที่ผสมก่อน hash IP (production ให้สุ่มค่ายาวๆ และห้ามเปลี่ยนภายหลัง ไม่งั้นนับผู้เข้าชมไม่ซ้ำผิด)
IP_HASH_SALT=dev-salt-change-me
# เขตเวลาที่ใช้ตัดวันในกราฟรายวัน
STATS_TIMEZONE=Asia/Bangkok
