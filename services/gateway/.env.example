# พอร์ตที่ gateway service รัน
PORT=3001
# connection string ของ gateway_db (local ใช้ docker-compose, production ใช้ Neon)
DATABASE_URL=postgres://gateway_user:gateway_pass@localhost:5434/gateway_db
# origin ของหน้าเว็บที่อนุญาตให้ส่ง POST/PATCH/DELETE ได้ คั่นด้วย , (กัน CSRF)
APP_ORIGINS=http://localhost:5173,http://localhost:3001
# อายุของ session เป็นวัน
SESSION_TTL_DAYS=7
# URL สาธารณะของ redirect service ใช้ประกอบเป็นลิงก์สั้น
SHORT_BASE_URL=http://localhost:3002
# key ลับที่ service ใช้เรียกกันเอง ต้องตั้งค่าเดียวกันทุก service (production ให้สุ่มค่ายาวๆ)
INTERNAL_API_KEY=dev-internal-key-change-me
# URL ภายในของ analytics service
ANALYTICS_URL=http://localhost:3003
